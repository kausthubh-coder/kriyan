{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@convex/*": ["../convex/*"],
      "@kriyan/client-core": ["../packages/client-core/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../convex/_generated/**/*.ts",
    "../packages/client-core/src/**/*.ts"
  ]
}

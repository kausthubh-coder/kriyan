# Kriyan - Root Environment Variables
# Copy this file to .env.local and fill in the values

# Convex deployment (auto-populated by `bunx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud

# Development-only fixture/reset functions remain disabled unless this is set
# on an isolated Convex development deployment. Use the deployment name only,
# never a deploy key or other credential.
# KRIYAN_DEV_DEPLOYMENT=your-development-deployment-name

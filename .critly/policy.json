{
  "$schema": "../node_modules/@kausthubh/critly/policy.schema.json",
  "fonts": ["Figtree"],
  "typeScale": [12, 14, 16, 20, 28, 40],
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64],
  "schemes": { "dark": {} },
  "pages": ["/sign-in", "/today", "/upcoming", "/inbox", "/browse", "/progress", "/settings"],
  "bannedPhrases": ["overdue", "garden", "Oops", "lorem"],
  "rules": {
    "spacing-scale": "error",
    "nested-radius": "error",
    "off-token-color": "error",
    "focus-ring": "error"
  },
  "note": "Tokens live in packages/core/src/tokens.ts; see docs/design/v3/README.md."
}

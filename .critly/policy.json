{
  "$schema": "../node_modules/@kausthubh/critly/policy.schema.json",
  "fonts": ["Inter"],
  "typeScale": [12, 14, 16, 20, 28, 40, 80],
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64],
  "schemes": {
    "light": {},
    "dark": {
      "media": true
    }
  },
  "pages": ["/sign-in", "/today", "/review", "/upcoming", "/inbox", "/browse", "/progress", "/settings"],
  "bannedPhrases": ["overdue", "garden", "Oops", "lorem"],
  "rules": {
    "spacing-scale": "error",
    "nested-radius": "error",
    "off-token-color": "error",
    "focus-ring": "error"
  },
  "note": "Tokens live in packages/core/src/tokens.ts; the look is docs/design/v4 (B2): light and dark, Inter."
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kriyan",
  "version": "0.1.0",
  "identifier": "app.kriyan.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kriyan",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

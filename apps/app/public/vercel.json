{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/app", "destination": "/today", "permanent": false },
    { "source": "/app/:path*", "destination": "/today", "permanent": false },
    { "source": "/mcp", "destination": "https://kriyan.app/mcp", "statusCode": 308 }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

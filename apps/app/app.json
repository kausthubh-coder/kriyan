{
  "expo": {
    "name": "Kriyan",
    "slug": "kriyan",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "kriyan",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.kriyan",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "versionCode": 5
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/favicon.png",
      "name": "Kriyan",
      "shortName": "Kriyan",
      "themeColor": "#ffffff",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icons/splash.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#070709"
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#d42f25",
          "defaultChannel": "reminders"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#ffffff",
    "owner": "kausthubh",
    "extra": {
      "eas": {
        "projectId": "6c332d90-6af8-4ea6-8c10-4ee8e0e93562"
      }
    }
  }
}

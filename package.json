{
  "name": "kriyan",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "bun run --filter @kriyan/convex dev",
    "dev:app": "bun run --filter @kriyan/app web",
    "dev:site": "bun run --filter @kriyan/site dev",
    "tokens": "bun run --filter @kriyan/core tokens",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run tokens --check && bun run typecheck && bun run lint && bun run test",
    "lint:ui": "critly check http://localhost:${PORT_APP:-8081}",
    "kriyan": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@kausthubh/critly": "^0.2.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
